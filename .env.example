# Server & Environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Security & Sessions
# Generate a strong 32+ character random string for production
SESSION_SECRET=replace-with-a-long-random-session-secret

# Database (MongoDB Atlas)
# When provided, Bloom connects to MongoDB Atlas via Mongoose.
# When omitted in local development, Bloom uses a persistent local SQLite store at ./data/bloom.sqlite.
MONGODB_URI=

# Email Service (Provider-Swappable)
# Supported: brevo
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=Bloom

# Optional CORS Origin Override (defaults to APP_URL in production)
CORS_ORIGIN=
